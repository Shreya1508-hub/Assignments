    if (arr[i] > largest) {
        largest = arr[i];
    }
}
console.log(largest);

//6.Use a for loop to check whether a given number is a perfect number (a number equal to the sum of its proper divisors). Example: 28.
let num = 28;
let sum = 0;
for (let i = 1; i < num; i++) {
    if (num % i === 0) {
        sum += i;
    }
}
if (sum === num) {
    console.log("Perfect number");
} else {
    console.log("Not a perfect number");
}

