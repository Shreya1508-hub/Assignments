//10.Create a multi-level nested switch program for an online food ordering system:
//First select Category: "veg" or "nonveg".
//Then select Item based on category.
//Finally select Size: "half" or "full" and print the final order summary with price.
let category = "veg";
let item = "pizza";
let size = "full";
let price;
switch (category) {
    case "veg":
        switch (item) {
            case "pizza":
                switch (size) {
                    case "half":
                        price = 150;
                        break;

                    case "full":
                        price = 250;
                        break;

                    default:
                        price = 0;
                }
                break;

            case "burger":
                switch (size) {
                    case "half":
                        price = 60;
                        break;

                    case "full":
                        price = 100;
                        break;

                    default:
                        price = 0;
                }
                break;

            default:
                price = 0;
        }
        break;

    case "nonveg":
        switch (item) {
            case "pizza":
                switch (size) {
                    case "half":
                        price = 200;
                        break;

                    case "full":
                        price = 350;
                        break;

                    default:
                        price = 0;
                }
                break;

            case "burger":
                switch (size) {
                    case "half":
                        price = 100;
                        break;

                    case "full":
                        price = 160;
                        break;

                    default:
                        price = 0;
                }
                break;

            default:
                price = 0;
        }
        break;

    default:
